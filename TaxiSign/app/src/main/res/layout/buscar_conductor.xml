<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"> <!-- Evita que se apague la pantalla mientras busca -->

    <!-- Mapa: Ocupa todo el fondo -->
    <fragment
        android:id="@+id/map_searching"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Mapa en tiempo real buscando conductores cercanos"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Overlay para mejorar contraste de iconos superiores si los hubiera -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_gradient_top"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Animación de Radar: Asegúrate que no distraiga demasiado -->
    <ImageView
        android:id="@+id/iv_radar_pulses"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_radar_pulse"
        app:layout_constraintBottom_toTopOf="@+id/card_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tarjeta Principal de Estado -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <!-- Indicador visual de carga -->
            <ProgressBar
                android:id="@+id/pb_searching"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:indeterminateTint="#1A73E8"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscando tu taxi..."
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:accessibilityHeading="true" />

            <!-- Contenedor de destino con alto contraste -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_ubicacion"
                android:padding="16dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:focusable="true"
                android:contentDescription="Destino: Universidad Nacional de Trujillo">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_location_pin"
                    app:tint="#424242"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:id="@+id/tv_destination_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hacia: Universidad Nacional de Trujillo"
                    android:textSize="16sp"
                    android:layout_marginStart="12dp"
                    android:textColor="#424242"/>
            </LinearLayout>

            <!-- Botón de Acción: Tamaño de toque (Touch Target) grande -->
            <Button
                android:id="@+id/btn_cancelar_busqueda"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:text="CANCELAR VIAJE"
                android:textSize="16sp"
                android:letterSpacing="0.05"
                android:textColor="#D32F2F"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#FFCDD2"
                app:rippleColor="#20F44336"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>