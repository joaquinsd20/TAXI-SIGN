        android:label="Taxi-Sign"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TaxiSign"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- GOOGLE MAPS API -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBXZDPoloKmzL9k0tDLBjfQ37hZ2kh87JE" />

