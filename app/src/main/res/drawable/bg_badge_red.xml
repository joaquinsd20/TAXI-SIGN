<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Color de fondo rojo -->
    <solid android:color="#FF0000" />

    <!-- Tamaño fijo para que se vea como un punto -->
    <size
        android:width="8dp"
        android:height="8dp" />

    <!-- Un pequeño borde blanco opcional para resaltar -->
    <stroke
        android:width="1dp"
        android:color="#FFFFFF" />
</shape>