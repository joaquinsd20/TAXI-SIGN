<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Fila de opcion en pantallas de Configuracion (icono + texto, sin apretar) -->
    <style name="TaxiSign.AjustesFila" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="iconTint">#FFD600</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">16dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Boton de accion peligrosa (Eliminar cuenta) -->
    <style name="TaxiSign.AjustesFila.Peligro" parent="Widget.Material3.Button.Icon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">#FF6B6B</item>
        <item name="backgroundTint">#3A1E1E</item>
        <item name="iconTint">#FF6B6B</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">16dp</item>
        <item name="cornerRadius">16dp</item>
    </style>


    <!-- Foto de perfil circular -->
    <style name="TaxiSign.FotoCircular" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
