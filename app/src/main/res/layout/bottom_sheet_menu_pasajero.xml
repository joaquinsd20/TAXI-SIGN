<?xml version="1.0" encoding="utf-8"?>
<!-- Menu del pasajero (boton de 3 rayas): hoja inferior con encabezado y opciones -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_menu_handle" />

        <!-- Encabezado: inicial, nombre y correo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMenuInicial"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_surface"
                android:gravity="center"
                android:text="P"
                android:textColor="#FFD600"
                android:textSize="22sp"
                android:textStyle="bold"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMenuNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pasajero"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMenuCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#9AA3B8"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="6dp"
            android:background="#252D47" />

        <LinearLayout
            android:id="@+id/opcionPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Mi perfil">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/bg_menu_icono"
                android:src="@drawable/ic_person"
                android:importantForAccessibility="no"
                app:tint="#FFD600" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Mi perfil"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:importantForAccessibility="no" />
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_right"
                android:importantForAccessibility="no"
                app:tint="#5C6680" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcionViajes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Mis viajes">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/bg_menu_icono"
                android:src="@drawable/ic_routes"
                android:importantForAccessibility="no"
                app:tint="#FFD600" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Mis viajes"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:importantForAccessibility="no" />
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_right"
                android:importantForAccessibility="no"
                app:tint="#5C6680" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcionLugares"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Mis lugares">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/bg_menu_icono"
                android:src="@drawable/ic_location_pin"
                android:importantForAccessibility="no"
                app:tint="#FFD600" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Mis lugares"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:importantForAccessibility="no" />
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_right"
                android:importantForAccessibility="no"
                app:tint="#5C6680" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcionCiudad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Cambiar ciudad">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/bg_menu_icono"
                android:src="@drawable/ic_location"
                android:importantForAccessibility="no"
                app:tint="#FFD600" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Cambiar ciudad"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:importantForAccessibility="no" />
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_right"
                android:importantForAccessibility="no"
                app:tint="#5C6680" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcionNotificaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Notificaciones">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/bg_menu_icono"
                android:src="@drawable/ic_notifications"
                android:importantForAccessibility="no"
                app:tint="#FFD600" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Notificaciones"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:importantForAccessibility="no" />
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_right"
                android:importantForAccessibility="no"
                app:tint="#5C6680" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcionConfiguracion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Configuración">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/bg_menu_icono"
                android:src="@drawable/ic_settings"
                android:importantForAccessibility="no"
                app:tint="#FFD600" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Configuración"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:importantForAccessibility="no" />
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_right"
                android:importantForAccessibility="no"
                app:tint="#5C6680" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcionSeguridad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Seguridad y contraseña">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/bg_menu_icono"
                android:src="@drawable/ic_lock"
                android:importantForAccessibility="no"
                app:tint="#FFD600" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Seguridad y contraseña"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:importantForAccessibility="no" />
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_right"
                android:importantForAccessibility="no"
                app:tint="#5C6680" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="6dp"
            android:background="#252D47" />

        <LinearLayout
            android:id="@+id/opcionCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Cerrar sesión">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/bg_menu_icono_peligro"
                android:src="@drawable/ic_logout"
                android:importantForAccessibility="no"
                app:tint="#FF6B6B" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Cerrar sesión"
                android:textColor="#FF6B6B"
                android:textSize="16sp"
                android:importantForAccessibility="no" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
