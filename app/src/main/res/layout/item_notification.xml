<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    android:padding="12dp"
    android:background="@drawable/bg_input_dark"
    android:elevation="4dp">

    <!-- FILA 1: Icono + Tipo + Hora + Botón leer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Icono de tipo de notificación -->
        <ImageView
            android:id="@+id/ivNotificationIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_notifications"
            app:tint="#FFD600"
            android:layout_marginEnd="10dp" />

        <!-- Tipo de notificación -->
        <TextView
            android:id="@+id/tvNotificationType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Solicitud de viaje"
            android:textColor="#FFD600"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Hora -->
        <TextView
            android:id="@+id/tvNotificationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hace 2 min"
            android:textColor="#9CA4C3"
            android:textSize="11sp"
            android:layout_marginEnd="8dp" />

        <!-- Indicador no leído (puntito) -->
        <View
            android:id="@+id/unreadIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_punto_rojo"
            android:visibility="visible" />
    </LinearLayout>

    <!-- FILA 2: Título/Asunto -->
    <TextView
        android:id="@+id/tvNotificationTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tu conductor Juan Pérez está en camino"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- FILA 3: Descripción -->
    <TextView
        android:id="@+id/tvNotificationMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Llegará en aproximadamente 5 minutos"
        android:textColor="#9CA4C3"
        android:textSize="13sp"
        android:layout_marginBottom="10dp" />

    <!-- FILA 4: Detalles adicionales (ej. conductor, placa) -->
    <LinearLayout
        android:id="@+id/detailsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <!-- Foto del conductor (circular) -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivDriverPhoto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/placeholder_driver"
            android:layout_marginEnd="10dp"
            app:civ_border_width="1dp"
            app:civ_border_color="#FFD600" />

        <!-- Info del conductor: nombre + placa -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDriverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Juan Pérez"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvVehicle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toyota Yaris"
                    android:textColor="#9CA4C3"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="#9CA4C3"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPlate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABC-123"
                    android:textColor="#FFD600"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Rating del conductor -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp">

            <RatingBar
                android:id="@+id/ratingDriver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.AppCompat.RatingBar.Small"
                android:numStars="5"
                android:rating="4.8"
                android:isIndicator="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.8"
                android:textColor="#FFD600"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- FILA 5: BOTONES DE ACCIÓN -->
    <LinearLayout
        android:id="@+id/actionButtonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <!-- Botón secundario: descartar / ok -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSecondaryAction"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="OK"
            android:textSize="12sp"
            android:fontFamily="@font/nunito_bold"
            android:textColor="#FFD600"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="#FFD600"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <!-- Botón principal: aceptar / contactar / ver -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimaryAction"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="VER DETALLES"
            android:textSize="12sp"
            android:fontFamily="@font/nunito_bold"
            android:textColor="#000000"
            app:backgroundTint="#FFD600"
            app:cornerRadius="8dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>