<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_input_dark">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_g_destino"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Destino"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_g_pasajero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Pasajero"
            android:textColor="#9CA4C3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_g_fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="01/01/2026"
            android:textColor="#9CA4C3"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_g_monto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="S/ 0.00"
        android:textColor="#FFD600"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
