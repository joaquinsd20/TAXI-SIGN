<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    tools:context=".pasajero.EditarPerfilPasajeroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@drawable/bg_borde"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:padding="10dp"
                android:rotation="180"
                android:src="@drawable/ic_arrow_right"
                app:tint="#FFD600"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Editar perfil"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- FOTO PERFIL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_perfil"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_amarillo_circular"
                android:padding="26dp"
                android:src="@drawable/ic_person"
                app:tint="#020617"/>

            <TextView
                android:id="@+id/btn_cambiar_foto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Cambiar foto"
                android:textColor="#FFD600"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_borde"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- NOMBRE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOMBRE"
                android:textColor="#FFD600"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edt_nombre"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:hint="Ingresa tu nombre"
                android:paddingHorizontal="16dp"
                android:text="Juan Pérez"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAB1CB"/>

            <!-- CORREO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="CORREO"
                android:textColor="#FFD600"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edt_correo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:hint="Ingresa tu correo"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:text="juan@gmail.com"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAB1CB"/>

            <!-- TELEFONO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="TELÉFONO"
                android:textColor="#FFD600"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edt_telefono"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:hint="Ingresa tu teléfono"
                android:inputType="phone"
                android:paddingHorizontal="16dp"
                android:text="999999999"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAB1CB"/>

            <!-- BOTON -->

            <LinearLayout
                android:id="@+id/btn_guardar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_button_yellow"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GUARDAR CAMBIOS"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>