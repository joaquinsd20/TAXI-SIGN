<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1320">

    <!-- MAPA -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapaBaseFragment"
        android:name="com.taxisign.pro.mapa.MapaBaseFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/card_busqueda"/>

    <!-- BOTÓN ATRÁS -->
    <ImageButton
        android:id="@+id/btn_back_busqueda"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_surface"
        android:src="@drawable/ic_arrow_back"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:elevation="6dp"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- TARJETA DE ESTADO (con radar integrado) -->
    <LinearLayout
        android:id="@+id/layout_estado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_surface_card"
        android:elevation="6dp"
        android:padding="14dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_back_busqueda"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_radar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/bg_radar_pulse"
            app:tint="#FFCE3A"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscando conductor…"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Esto puede tardar unos segundos"
                android:textColor="#9AA3B8"
                android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- HOJA INFERIOR: OFERTAS -->
    <LinearLayout
        android:id="@+id/card_busqueda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_sheet_top"
        android:elevation="12dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_handle"/>

        <!-- Destino -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_surface_soft"
            android:padding="14dp">

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_dot_accent"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Destino"
                    android:textColor="#9AA3B8"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtDestinoSeleccionado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Destino seleccionado"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Título ofertas -->
        <TextView
            android:id="@+id/tv_titulo_ofertas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Ofertas de conductores"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <!-- Lista de ofertas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_ofertas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="280dp"
            android:nestedScrollingEnabled="true"/>

        <!-- Cancelar -->
        <LinearLayout
            android:id="@+id/btn_cancelar_busqueda"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_outline">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelar búsqueda"
                android:textColor="#FF6B6B"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
