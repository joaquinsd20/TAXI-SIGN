<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_taxi_neon"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="30dp">
        <ImageButton
            android:id="@+id/btnBackGanancias"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFD600" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ganancias"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginStart="15dp"/>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#151B31"
        app:cardCornerRadius="25dp"
        android:layout_marginBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="30dp"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saldo para retirar"
                android:textColor="#B8C1D9" />
            <TextView
                android:id="@+id/tvSaldoActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ 450.00"
                android:textColor="#FFD600"
                android:textSize="38sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnVerHistorial"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="VER HISTORIAL DE VIAJES"
        android:backgroundTint="#252D47"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="15dp"
        app:cornerRadius="15dp"
        app:icon="@android:drawable/ic_menu_recent_history"
        app:iconTint="#FFD600"/>

    <Button
        android:id="@+id/btnRetirar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="RETIRAR DINERO"
        android:backgroundTint="#FFD600"
        android:textColor="#151B31"
        android:textStyle="bold"
        app:cornerRadius="15dp"/>

</LinearLayout>