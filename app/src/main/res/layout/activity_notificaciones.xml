<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:orientation="vertical"
    tools:context=".notificaciones.NotificationsActivity">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:id="@+id/headerNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp">

        <ImageButton
            android:id="@+id/btnBackNotifications"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_header_oscuro"
            android:contentDescription="Volver"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFD600" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Notificaciones"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMarkAllRead"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_header_oscuro"
            android:contentDescription="Marcar todas como leídas"
            android:padding="11dp"
            android:src="@drawable/ic_check"
            app:tint="#FFD600" />
    </LinearLayout>

    <!-- PESTAÑAS -->
    <LinearLayout
        android:id="@+id/tabsContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_tabs_segmentado"
        android:orientation="horizontal"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/tabAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_activa"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTabAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todas"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabUnread"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTabUnread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sin leer"
                android:textColor="#9AA3B8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badgeUnreadCount"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_contador"
                android:gravity="center"
                android:minWidth="20dp"
                android:paddingHorizontal="6dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_notification" />

        <!-- ESTADO VACIO -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_circle_surface"
                android:importantForAccessibility="no"
                android:padding="24dp"
                android:src="@drawable/ic_notifications"
                app:tint="#FFD600" />

            <TextView
                android:id="@+id/tvVacioTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Todo al día"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVacioMensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Aquí verás los avisos de tus viajes y de seguridad."
                android:textColor="#9AA3B8"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
