<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_taxi_neon"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/containerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/checkbox_on_background"
            app:tint="#4CAF50"
            android:layout_marginBottom="16dp"
            android:contentDescription="Éxito" />

        <TextView
            android:id="@+id/tvMensajeExito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Viaje Asignado con Éxito!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:gravity="center"/>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardDetallesViaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#151B31"
        app:cardCornerRadius="26dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/containerHeader"
        app:layout_constraintBottom_toTopOf="@id/btnIniciarRuta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginVertical="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASAJERO"
                android:textColor="#B8C1D9"
                android:textSize="11sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvNombrePasajero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carlos Mendoza"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#252D47"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PUNTO DE RECOJO"
                android:textColor="#FFD600"
                android:textSize="11sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvDireccionOrigen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Av. Larco 456 - Entrada Principal"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESTINO"
                android:textColor="#B8C1D9"
                android:textSize="11sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvDireccionDestino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mall Aventura - Zona de Estacionamiento"
                android:textColor="#FFFFFF"
                android:textSize="15sp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnIniciarRuta"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="IR A RECOGER AL PASAJERO"
        android:backgroundTint="#FFD600"
        android:textColor="#000000"
        android:textStyle="bold"
        app:cornerRadius="15dp"
        android:minHeight="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="24dp"
        tools:ignore="VisualLintButtonSize" />

</androidx.constraintlayout.widget.ConstraintLayout>