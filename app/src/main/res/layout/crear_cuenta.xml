<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_taxi_neon"
    tools:context=".CrearCuenta">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- BOTON VOLVER -->

        <ImageButton
            android:id="@+id/btnVolverRegistro"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="22dp"
            android:background="@android:color/transparent"
            android:contentDescription="Volver"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFD600"/>

        <!-- LOGO -->

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_taxi"
            app:layout_constraintTop_toBottomOf="@id/btnVolverRegistro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- TITULO -->

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:text="Crear Cuenta"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/imgLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- SUBTITULO -->

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Únete a Taxi Service App"
            android:textColor="#B8C1D9"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- CARD PRINCIPAL -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardRegistro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="22dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#151B31"
            app:cardCornerRadius="20dp"
            app:cardElevation="14dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- NOMBRE -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:boxBackgroundColor="#0B1020"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="#2A3352"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="#FFD600">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombreCompleto"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:hint="Nombre completo"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#7E8695"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- EMAIL -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:boxBackgroundColor="#0B1020"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="#2A3352"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="#FFD600">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmailRegistro"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:hint="Correo electrónico"
                        android:inputType="textEmailAddress"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#7E8695"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- PASSWORD -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    app:boxBackgroundColor="#0B1020"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="#2A3352"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#B8C1D9"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="#FFD600">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassRegistro"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:hint="Contraseña"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#7E8695"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- BOTON -->

                <Button
                    android:id="@+id/btnRegistrarAhora"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_button_yellow"
                    android:text="CREAR CUENTA"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- LOGIN -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/cardRegistro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Ya tienes una cuenta?"
                android:textColor="#AEB6CF"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tvYaTengoCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Inicia sesión aquí"
                android:textColor="#FFD600"
                android:textSize="20sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>