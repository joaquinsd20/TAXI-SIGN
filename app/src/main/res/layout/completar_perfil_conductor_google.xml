<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/headerCompletarPerfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnVolverCompletarPerfil"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFD600"
            android:contentDescription="Volver"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Completa tu perfil"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- SCROLL CON EL FORMULARIO -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerCompletarPerfil"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- ÍCONO + BIENVENIDA CON DATOS DE GOOGLE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_icon_blue">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_taxi"
                        app:tint="#FFD600"/>

                </FrameLayout>

                <TextView
                    android:id="@+id/tvSaludoGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="¡Hola!"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Ya iniciaste sesión con Google. Solo nos falta validar algunos datos antes de subir tus documentos."
                    android:textColor="#AAB1CB"
                    android:textSize="13sp"/>

            </LinearLayout>

            <!-- BANNER DE PASO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_borde"
                android:padding="12dp"
                android:layout_marginBottom="18dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="#FFD600"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Paso 1 de 2: Datos personales y del vehículo. Luego subirás tus documentos para validación."
                    android:textColor="#D6DBEC"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- CARD: DATOS PERSONALES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Datos personales"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:textColor="#B8C1D9"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_borde"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <!-- DNI -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="DNI"
                    app:boxBackgroundColor="#0B1220"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#FFD600"
                    app:boxStrokeWidth="1dp"
                    app:hintTextColor="#AAB1CB"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="#AAB1CB"
                    app:counterEnabled="true"
                    app:counterMaxLength="8">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDniGoogleConductor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="8"
                        android:textColor="#FFFFFF"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- TELÉFONO -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Número de celular"
                    app:boxBackgroundColor="#0B1220"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#FFD600"
                    app:boxStrokeWidth="1dp"
                    app:hintTextColor="#AAB1CB"
                    app:startIconDrawable="@drawable/ic_phone"
                    app:startIconTint="#AAB1CB"
                    app:counterEnabled="true"
                    app:counterMaxLength="9">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTelefonoGoogleConductor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:maxLength="9"
                        android:hint="987654321"
                        android:textColor="#FFFFFF"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- CARD: DATOS DEL VEHÍCULO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Datos del vehículo"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:textColor="#B8C1D9"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_borde"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <!-- PLACA -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="Placa del vehículo"
                    app:boxBackgroundColor="#0B1220"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#FFD600"
                    app:boxStrokeWidth="1dp"
                    app:hintTextColor="#AAB1CB"
                    app:startIconDrawable="@drawable/ic_taxi"
                    app:startIconTint="#AAB1CB">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPlacaGoogleConductor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:hint="ABC-123"
                        android:textColor="#FFFFFF"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- MODELO -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="Modelo del vehículo"
                    app:boxBackgroundColor="#0B1220"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#FFD600"
                    app:boxStrokeWidth="1dp"
                    app:hintTextColor="#AAB1CB"
                    app:startIconDrawable="@drawable/ic_check"
                    app:startIconTint="#AAB1CB">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etModeloGoogleConductor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Toyota Yaris 2020"
                        android:textColor="#FFFFFF"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- COLOR -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Color del vehículo"
                    app:boxBackgroundColor="#0B1220"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#FFD600"
                    app:boxStrokeWidth="1dp"
                    app:hintTextColor="#AAB1CB"
                    app:startIconDrawable="@drawable/ic_check"
                    app:startIconTint="#AAB1CB">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etColorGoogleConductor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Blanco"
                        android:textColor="#FFFFFF"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- BOTÓN SIGUIENTE -->
            <Button
                android:id="@+id/btnSiguienteCompletarPerfil"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="SIGUIENTE: SUBIR DOCUMENTOS"
                android:textColor="#151B31"
                android:textStyle="bold"
                android:textSize="14sp"
                android:backgroundTint="#FFD600"
                app:cornerRadius="16dp"/>

            <!-- NOTA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Al continuar aceptas los Términos y Condiciones de TaxiSign"
                android:textColor="#666F8F"
                android:textSize="12sp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
