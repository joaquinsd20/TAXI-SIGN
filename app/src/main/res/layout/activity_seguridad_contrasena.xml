<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_taxi_neon"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/toolbarSeguridad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackSeguridad"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFD600"
            android:contentDescription="Volver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seguridad"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="15dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbarSeguridad"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Actualizar Contraseña"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:textColor="#B8C1D9"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#151B31"
                app:cardCornerRadius="26dp"
                app:cardElevation="6dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contraseña Actual"
                        android:textColor="#B8C1D9"
                        android:textSize="12sp"/>

                    <EditText
                        android:id="@+id/etPassActualSegura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="••••••••"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5A648C"
                        android:backgroundTint="#FFD600"
                        android:inputType="textPassword"
                        android:textSize="15sp"
                        android:layout_marginBottom="20dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nueva Contraseña"
                        android:textColor="#B8C1D9"
                        android:textSize="12sp"/>

                    <EditText
                        android:id="@+id/etPassNuevaSegura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="Mínimo 6 caracteres"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5A648C"
                        android:backgroundTint="#FFD600"
                        android:inputType="textPassword"
                        android:textSize="15sp"
                        android:layout_marginBottom="20dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirmar Nueva Contraseña"
                        android:textColor="#B8C1D9"
                        android:textSize="12sp"/>

                    <EditText
                        android:id="@+id/etPassConfirmarSegura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="Repite tu nueva contraseña"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5A648C"
                        android:backgroundTint="#FFD600"
                        android:inputType="textPassword"
                        android:textSize="15sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnGuardarClave"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="CAMBIAR CONTRASEÑA"
                android:backgroundTint="#FFD600"
                android:textColor="#000000"
                android:textStyle="bold"
                app:cornerRadius="15dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>