<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/aviso_ubicacion_fondo_icono_desc"
            android:src="@drawable/ic_ubicacion_segundo_plano" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/aviso_ubicacion_fondo_titulo"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/aviso_ubicacion_fondo_subtitulo"
            android:textColor="#FFCE3A"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/aviso_ubicacion_fondo_intro"
            android:textColor="#B8C1D9"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_bloque_informativo_oscuro"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aviso_ubicacion_fondo_que"
                android:textColor="#FFCE3A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/aviso_ubicacion_fondo_que_detalle"
                android:textColor="#E4E8F5"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/aviso_ubicacion_fondo_por_que"
                android:textColor="#FFCE3A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/aviso_ubicacion_fondo_por_que_detalle"
                android:textColor="#E4E8F5"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/aviso_ubicacion_fondo_como"
                android:textColor="#FFCE3A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/aviso_ubicacion_fondo_como_detalle"
                android:textColor="#E4E8F5"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/aviso_ubicacion_fondo_controls"
                android:textColor="#FFCE3A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/aviso_ubicacion_fondo_controls_detalle"
                android:textColor="#E4E8F5"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvLinkPoliticaPrivacidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/aviso_ubicacion_fondo_politica"
            android:textColor="#8FA3FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAceptarUbicacionFondo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_boton_amarillo"
            android:stateListAnimator="@null"
            android:text="@string/aviso_ubicacion_fondo_aceptar"
            android:textAllCaps="false"
            android:textColor="#151B31"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRechazarUbicacionFondo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_boton_outline_oscuro"
            android:stateListAnimator="@null"
            android:text="@string/aviso_ubicacion_fondo_rechazar"
            android:textAllCaps="false"
            android:textColor="#B8C1D9"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/aviso_ubicacion_fondo_obligatorio"
            android:textColor="#7A8499"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
