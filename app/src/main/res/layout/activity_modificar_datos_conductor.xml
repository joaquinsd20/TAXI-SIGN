<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_taxi_neon"
    android:fitsSystemWindows="true"
    tools:context=".conductor.ModificarDatosConductor">

    <!-- TOOLBAR SUPERIOR -->
    <LinearLayout
        android:id="@+id/toolbarEditar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <ImageButton
            android:id="@+id/btn_cancelar_edicion"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFD600"
            android:contentDescription="Cancelar edición y regresar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar Perfil"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- CUERPO DEL FORMULARIO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbarEditar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- FOTO DE PERFIL Y BOTÓN PARA CAMBIARLA -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_foto_perfil"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    app:cardCornerRadius="55dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/img_editar_conductor"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person"
                        android:background="#151B31"
                        app:tint="#FFD600" />
                </androidx.cardview.widget.CardView>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab_cambiar_foto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@id/card_foto_perfil"
                    android:layout_alignEnd="@id/card_foto_perfil"
                    app:fabSize="mini"
                    android:src="@android:drawable/ic_menu_camera"
                    app:backgroundTint="#FFD600"
                    app:tint="#000000"
                    android:contentDescription="Cambiar foto de perfil" />
            </RelativeLayout>

            <!-- SECCIÓN DATOS PERSONALES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Datos Personales"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:textColor="#B8C1D9"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#151B31"
                app:cardCornerRadius="26dp"
                app:cardElevation="6dp"
                android:layout_marginBottom="30dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:orientation="vertical">

                    <!-- NOMBRE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre Completo"
                        android:textColor="#B8C1D9"
                        android:textSize="12sp"/>

                    <EditText
                        android:id="@+id/et_editar_nombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="Juan Pérez"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5A648C"
                        android:backgroundTint="#FFD600"
                        android:inputType="textPersonName"
                        android:textSize="15sp"
                        android:layout_marginBottom="16dp"/>

                    <!-- TELÉFONO -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Número Telefónico"
                        android:textColor="#B8C1D9"
                        android:textSize="12sp"/>

                    <EditText
                        android:id="@+id/et_editar_telefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="987654321"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5A648C"
                        android:backgroundTint="#FFD600"
                        android:inputType="phone"
                        android:textSize="15sp"
                        android:layout_marginBottom="16dp"/>

                    <!-- CORREO -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Correo Electrónico"
                        android:textColor="#B8C1D9"
                        android:textSize="12sp"/>

                    <EditText
                        android:id="@+id/et_editar_correo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="conductor@taxisign.com"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5A648C"
                        android:backgroundTint="#FFD600"
                        android:inputType="textEmailAddress"
                        android:textSize="15sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BOTÓN GUARDAR CAMBIOS -->
            <Button
                android:id="@+id/btn_guardar_datos_personales"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="GUARDAR CAMBIOS"
                android:backgroundTint="#FFD600"
                android:textColor="#000000"
                android:textStyle="bold"
                app:cornerRadius="15dp"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>