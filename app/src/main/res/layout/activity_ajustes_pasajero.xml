<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_borde"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageButton
                android:id="@+id/btnBackAjustesPasajero"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:padding="9dp"
                android:rotation="180"
                android:src="@drawable/ic_arrow_right"
                app:tint="#FFD600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Configuración"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#101827"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cuenta de pasajero"
                    android:textColor="#FFD600"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Administra la seguridad de tu cuenta y solicita ayuda del soporte TaxiSign."
                    android:textColor="#AAB1CB"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSeguridadPasajero"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#1E293B"
                    android:gravity="start|center_vertical"
                    android:paddingStart="18dp"
                    android:text="Seguridad y contraseña"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:icon="@android:drawable/ic_lock_lock"
                    app:iconTint="#FFD600" />

                <Button
                    android:id="@+id/btnSoportePasajero"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#1E293B"
                    android:gravity="start|center_vertical"
                    android:paddingStart="18dp"
                    android:text="Chatear / contactar soporte"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:icon="@android:drawable/ic_dialog_email"
                    app:iconTint="#FFD600" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Soporte: taxisign@hotmail.com"
                    android:textColor="#AAB1CB"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#190F12"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zona de seguridad"
                    android:textColor="#FF5252"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Puedes solicitar la eliminación de tu cuenta y datos asociados."
                    android:textColor="#AAB1CB"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnEliminarCuentaPasajero"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#FF5252"
                    android:text="Eliminar cuenta"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
