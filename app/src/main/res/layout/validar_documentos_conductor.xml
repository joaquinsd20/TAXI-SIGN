<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/header_documentos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_borde"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📄 Validación de documentos"
            android:textColor="#FFD600"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sube los documentos requeridos para activar tu cuenta de conductor"
            android:textColor="#AAB1CB"
            android:textSize="13sp"/>

    </LinearLayout>

    <!-- SCROLL DE DOCUMENTOS -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/header_documentos"
        app:layout_constraintBottom_toTopOf="@id/btnFinalizarRegistroConductor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- ── BREVETE ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_borde"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_blue">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        app:tint="#2196F3"/>

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brevete (Licencia)"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvEstadoBrevete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sin seleccionar"
                        android:textColor="#AAB1CB"
                        android:textSize="13sp"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btnSubirBrevete"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Subir"
                    android:textColor="#151B31"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:backgroundTint="#FFD600"
                    app:cornerRadius="12dp"/>

            </LinearLayout>

            <!-- ── SOAT ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_borde"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_green">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_taxi"
                        app:tint="#4CAF50"/>

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOAT (Seguro vehicular)"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvEstadoSoat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sin seleccionar"
                        android:textColor="#AAB1CB"
                        android:textSize="13sp"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btnSubirSoat"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Subir"
                    android:textColor="#151B31"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:backgroundTint="#FFD600"
                    app:cornerRadius="12dp"/>

            </LinearLayout>

            <!-- ── ANTECEDENTES ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_borde"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_punto_amarillo">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lock"
                        app:tint="#FFD600"/>

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Antecedentes penales"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvEstadoAntecedentes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sin seleccionar"
                        android:textColor="#AAB1CB"
                        android:textSize="13sp"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btnSubirAntecedentes"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Subir"
                    android:textColor="#151B31"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:backgroundTint="#FFD600"
                    app:cornerRadius="12dp"/>

            </LinearLayout>

            <!-- NOTA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="📌 Formatos aceptados: PDF, JPG o PNG. Tus documentos serán revisados por el equipo de TaxiSign en un plazo de 24 a 48 horas."
                android:textColor="#666F8F"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- BOTÓN FINALIZAR -->
    <Button
        android:id="@+id/btnFinalizarRegistroConductor"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:text="FINALIZAR REGISTRO"
        android:textColor="#151B31"
        android:textStyle="bold"
        android:textSize="16sp"
        android:backgroundTint="#FFD600"
        app:cornerRadius="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>