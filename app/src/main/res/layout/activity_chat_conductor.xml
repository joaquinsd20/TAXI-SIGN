<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/header_chat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#1E1E1E"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_volver"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFD600"
            android:contentDescription="Volver" />

        <TextView
            android:id="@+id/tv_avatar_pasajero"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="P"
            android:textColor="#121212"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:drawable/toast_frame" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tv_nombre_pasajero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pasajero"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badge_sordo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤟 Usuario sordo/mudo"
                android:textColor="#FFD600"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_modo_senas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤟 Señas"
                    android:textColor="#FFD600"
                    android:textSize="11sp"
                    app:thumbTint="#FFD600"
                    app:trackTint="#666666" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_modo_voz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="🔊 Voz"
                    android:textColor="#FFD600"
                    android:textSize="11sp"
                    app:thumbTint="#FFD600"
                    app:trackTint="#666666" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_mensajes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/header_chat"
        app:layout_constraintBottom_toTopOf="@id/panel_respuestas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/panel_respuestas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A" />

        <LinearLayout
            android:id="@+id/contenedor_respuestas_rapidas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="2dp"
                android:text="Respuesta rápida"
                android:textColor="#666666"
                android:textSize="10sp"
                android:letterSpacing="0.06" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="3dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ok"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#1E3A2F"
                    android:text="👍 OK"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_enseguida"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#1E2E3A"
                    android:text="⏱️ ENSEGUIDA"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_donde_estas"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#2E2A1E"
                    android:text="📍 ¿DÓNDE?"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="10dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_entendido"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#1E3A2F"
                    android:text="✅ ENTENDIDO"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_no_encuentro"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#3A1E1E"
                    android:text="❓ NO LO VEO"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_llegue"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#1E2E1E"
                    android:text="🚕 LLEGUÉ"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="10dp" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A" />

        <LinearLayout
            android:id="@+id/contenedor_mensaje_libre"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_escribir"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="✏️ Escribir mensaje"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp" />

            <EditText
                android:id="@+id/et_mensaje_libre"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:visibility="gone"
                android:background="#242424"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="Escribe..."
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:maxLines="1"
                android:singleLine="true"
                android:inputType="textCapSentences" />

            <ImageButton
                android:id="@+id/btn_enviar_libre"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:visibility="gone"
                android:background="#FFD600"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#121212"
                android:contentDescription="Enviar" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>