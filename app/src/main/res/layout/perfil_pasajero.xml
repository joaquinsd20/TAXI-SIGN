<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:fillViewport="true"
    tools:context=".pasajero.PerfilPasajeroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_header_oscuro"
                android:contentDescription="Volver"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFD600" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Mi perfil"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TARJETA PRINCIPAL: foto, nombre, calificacion -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_viaje"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="24dp">

            <FrameLayout
                android:id="@+id/layoutFoto"
                android:layout_width="116dp"
                android:layout_height="116dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_perfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_foto_perfil"
                    android:contentDescription="Foto de perfil"
                    android:padding="28dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    app:shapeAppearanceOverlay="@style/TaxiSign.FotoCircular"
                    app:strokeColor="#FFD600"
                    app:strokeWidth="3dp"
                    app:tint="#FFD600" />

                <ImageButton
                    android:id="@+id/btnEditarFoto"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_boton_camara"
                    android:contentDescription="Cambiar foto de perfil"
                    android:padding="10dp"
                    android:src="@drawable/ic_camara"
                    app:tint="#111827" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNombreUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Pasajero"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_rol"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="Pasajero"
                    android:textColor="#C7CDDC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvRatingPasajero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_rol"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="⭐ Sin calificaciones"
                    android:textColor="#FFD600"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="Datos personales"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_viaje"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Nombre completo"
                android:textColor="#9AA3B8"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_dark"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="12dp"
                android:hint="Tu nombre y apellidos"
                android:importantForAutofill="no"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7491"
                android:textSize="15sp"
                android:inputType="textPersonName|textCapWords"
                app:drawableTint="#FFD600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Correo electrónico"
                android:textColor="#9AA3B8"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_correo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_dark"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="12dp"
                android:hint="correo@ejemplo.com"
                android:importantForAutofill="no"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7491"
                android:textSize="15sp"
                android:inputType="textEmailAddress"
                app:drawableTint="#FFD600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Teléfono"
                android:textColor="#9AA3B8"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_telefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_dark"
                android:drawableStart="@drawable/ic_phone"
                android:drawablePadding="12dp"
                android:hint="987 654 321"
                android:importantForAutofill="no"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7491"
                android:textSize="15sp"
                android:inputType="phone"
                app:drawableTint="#FFD600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="DNI"
                android:textColor="#9AA3B8"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_dni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:background="@drawable/bg_input_dark"
                android:drawableStart="@drawable/ic_id"
                android:drawablePadding="12dp"
                android:hint="8 dígitos"
                android:importantForAutofill="no"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7491"
                android:textSize="15sp"
                android:inputType="number"
                android:maxLength="8"
                app:drawableTint="#FFD600" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="Accesibilidad"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_viaje"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="¿Cómo te comunicas?"
                android:textColor="#9AA3B8"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgAccesibilidadPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbPerfilSordo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_opcion_radio"
                    android:buttonTint="#FFD600"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="Sordo\nNo escucho"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbPerfilMudo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_opcion_radio"
                    android:buttonTint="#FFD600"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="Mudo\nNo hablo"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbPerfilSordomudo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_opcion_radio"
                    android:buttonTint="#FFD600"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="Sordomudo\nNo escucho ni hablo"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbPerfilNormal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:background="@drawable/bg_opcion_radio"
                    android:buttonTint="#FFD600"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="Sin condición\nEscucho y hablo"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🔒 Tus datos solo se usan para tus viajes y se guardan de forma segura."
                android:textColor="#9AA3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- GUARDAR -->
        <LinearLayout
            android:id="@+id/btn_guardar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_yellow"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardar cambios"
                android:textColor="#111827"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
