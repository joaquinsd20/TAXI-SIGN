<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_taxi_neon"
    tools:context=".pasajero.PerfilPasajeroActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="24dp"
            android:background="@android:color/transparent"
            android:padding="18dp"
            android:src="@drawable/ic_arrow_right"
            android:rotation="180"
            app:tint="#FFD600"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Completa tu perfil"
            android:textColor="#FFD600"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Para ofrecerte la mejor experiencia"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/layoutProgreso"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="25dp"
            android:layout_marginEnd="22dp"
            android:background="@drawable/bg_input_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_person"
                app:tint="#FFD600"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="80"
                    android:max="100"
                    android:progressTint="#FFD600"
                    style="?android:attr/progressBarStyleHorizontal"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Perfil 80% completado"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"/>

            </LinearLayout>

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/bg_borde"
                android:text="80%"
                android:textColor="#FFD600"
                android:textStyle="bold"/>

        </LinearLayout>

        <FrameLayout
            android:id="@+id/layoutFoto"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_marginTop="34dp"
            app:layout_constraintTop_toBottomOf="@id/layoutProgreso"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/iv_perfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_amarillo_circular"
                android:padding="34dp"
                android:src="@drawable/ic_person"
                app:tint="#FFD600"/>

            <ImageButton
                android:id="@+id/btnEditarFoto"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_amarillo_circular"
                android:padding="14dp"
                android:src="@drawable/ic_camara"
                app:tint="#FFD600"/>

        </FrameLayout>

        <TextView
            android:id="@+id/tvNombreUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Usuario Logueado"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/layoutFoto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pasajero"
            android:textColor="#AAB1CB"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tvNombreUsuario"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/cardInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="22dp"
            android:background="@drawable/bg_borde"
            android:orientation="vertical"
            android:padding="18dp"
            app:layout_constraintTop_toBottomOf="@id/tvNombreUsuario"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText
                android:id="@+id/et_nombre"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_dark"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="12dp"
                android:hint="Nombre completo"
                android:paddingStart="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8F96B2"
                app:drawableTint="#FFD600"/>

            <EditText
                android:id="@+id/et_correo"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_dark"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="12dp"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8F96B2"
                app:drawableTint="#FFD600"/>

            <EditText
                android:id="@+id/et_telefono"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_dark"
                android:drawableStart="@drawable/ic_phone"
                android:drawablePadding="12dp"
                android:hint="Número de teléfono"
                android:inputType="phone"
                android:paddingStart="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8F96B2"
                app:drawableTint="#FFD600"/>

            <EditText
                android:id="@+id/et_dni"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_dark"
                android:drawableStart="@drawable/ic_id"
                android:drawablePadding="12dp"
                android:hint="DNI"
                android:inputType="number"
                android:paddingStart="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8F96B2"
                app:drawableTint="#FFD600"/>

            <EditText
                android:id="@+id/et_ciudad"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_input_dark"
                android:drawableStart="@drawable/ic_location"
                android:drawablePadding="12dp"
                android:hint="Ciudad"
                android:paddingStart="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8F96B2"
                app:drawableTint="#FFD600"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Tu información está segura con nosotros."
                android:textColor="#AAB1CB"
                android:textSize="13sp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_guardar"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="22dp"
            android:background="@drawable/bg_button_yellow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            app:layout_constraintTop_toBottomOf="@id/cardInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="#000000"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="CONTINUAR"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Este paso es obligatorio para continuar"
            android:textColor="#AAB1CB"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/btn_guardar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>