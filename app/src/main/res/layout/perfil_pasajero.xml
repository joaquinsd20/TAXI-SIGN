<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_taxi_neon"
    tools:context=".pasajero.PerfilPasajeroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_right"
                android:rotation="180"
                app:tint="#FFD600"/>

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Completa tu perfil"
                android:textColor="#FFD600"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="44dp"
                android:layout_height="44dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Para ofrecerte la mejor experiencia"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="13sp"/>

        <LinearLayout
            android:id="@+id/layoutProgreso"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_person"
                app:tint="#FFD600"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:progress="80"
                    android:max="100"
                    android:progressTint="#FFD600"
                    style="?android:attr/progressBarStyleHorizontal"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Perfil 80% completado"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:background="@drawable/bg_borde"
                android:text="80%"
                android:textColor="#FFD600"
                android:textStyle="bold"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/layoutFoto"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:layout_marginTop="22dp">

            <ImageView
                android:id="@+id/iv_perfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_amarillo_circular"
                android:padding="24dp"
                android:src="@drawable/ic_person"
                app:tint="#FFD600"/>

            <ImageButton
                android:id="@+id/btnEditarFoto"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_amarillo_circular"
                android:padding="10dp"
                android:src="@drawable/ic_camara"
                app:tint="#FFD600"/>
        </FrameLayout>

        <TextView
            android:id="@+id/tvNombreUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Usuario Logueado"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvRatingPasajero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="⭐ Sin calificaciones todavía"
            android:textColor="#FFD600"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pasajero"
            android:textColor="#AAB1CB"
            android:textSize="13sp"
            android:gravity="center"/>

        <LinearLayout
            android:id="@+id/cardInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_borde"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <EditText
                android:id="@+id/et_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_dark"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="10dp"
                android:hint="Nombre completo"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8F96B2"
                android:textSize="14sp"
                app:drawableTint="#FFD600"/>

            <EditText
                android:id="@+id/et_correo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_dark"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="10dp"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8F96B2"
                android:textSize="14sp"
                app:drawableTint="#FFD600"/>

            <EditText
                android:id="@+id/et_telefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_dark"
                android:drawableStart="@drawable/ic_phone"
                android:drawablePadding="10dp"
                android:hint="Número de teléfono"
                android:inputType="phone"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8F96B2"
                android:textSize="14sp"
                app:drawableTint="#FFD600"/>

            <EditText
                android:id="@+id/et_dni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_dark"
                android:drawableStart="@drawable/ic_id"
                android:drawablePadding="10dp"
                android:hint="DNI"
                android:inputType="number"
                android:maxLength="8"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8F96B2"
                android:textSize="14sp"
                app:drawableTint="#FFD600" />

            <EditText
                android:id="@+id/et_tipo_discapacidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="@drawable/bg_input_dark"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="10dp"
                android:hint="Ej: Sordo, mudo, sordomudo"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8F96B2"
                android:textSize="14sp"
                app:drawableTint="#FFD600"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Tu información está segura con nosotros."
                android:textColor="#AAB1CB"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_guardar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_yellow"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTINUAR"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>