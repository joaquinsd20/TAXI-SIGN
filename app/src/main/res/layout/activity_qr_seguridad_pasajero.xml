<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#0F1428">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 Código de seguridad"
        android:textColor="#FFD600"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Muéstrale este QR a tu conductor para iniciar el viaje de forma segura."
        android:textColor="#C7CEE3"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/img_qr"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="28dp"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:contentDescription="Código QR" />

    <TextView
        android:id="@+id/tv_codigo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="----"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.3" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Si no puede escanear, dile este número."
        android:textColor="#9CA4C3"
        android:textSize="12sp" />

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        style="?android:attr/progressBarStyle"
        android:indeterminateTint="#FFD600" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Esperando a que el conductor valide..."
        android:textColor="#9CA4C3"
        android:textSize="13sp" />

</LinearLayout>
