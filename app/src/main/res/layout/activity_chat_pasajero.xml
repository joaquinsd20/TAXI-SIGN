<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:id="@+id/header_chat"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="#1E1E1E"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_volver"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFD600"
            android:contentDescription="Volver" />


        <TextView
            android:id="@+id/tv_avatar_conductor"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="C"
            android:textColor="#121212"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@android:drawable/presence_audio_online"
            android:backgroundTint="#FFD600" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_nombre_conductor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conductor"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="🤟 Comunicación visual"
                android:textColor="#FFD600"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:id="@+id/indicador_nuevo_msg"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@android:drawable/presence_online"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_mensajes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/header_chat"
        app:layout_constraintBottom_toTopOf="@id/card_respuesta_conductor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_respuesta_conductor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/layout_panel_inferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="C"
                android:textColor="#121212"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@android:drawable/toast_frame" />

            <TextView
                android:id="@+id/tv_respuesta_conductor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Entendido, ya voy"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/layout_panel_inferior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/tab_ubicacion"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📍 Ubicación"
                android:textColor="#FFD600"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tab_instrucciones"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🗺️ Ruta"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tab_personal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🤟 Personal"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/grid_ubicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="8dp"
            android:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_estoy_aqui"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="#1E3A2F"
                android:text="ESTOY\nAQUÍ"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/ic_menu_mylocation"
                app:iconGravity="top"
                app:iconSize="28dp"
                app:iconTint="#4CAF50" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sigo_caminando"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:backgroundTint="#1E2E3A"
                android:text="SIGO\nCAMINANDO"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/ic_menu_directions"
                app:iconGravity="top"
                app:iconSize="28dp"
                app:iconTint="#2196F3" />
        </GridLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="#2A2A2A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mensaje_libre"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_weight="0"
                android:text="✏️  Escribir mensaje personalizado"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp" />

            <EditText
                android:id="@+id/et_mensaje_libre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:hint="Escribe tu mensaje..."
                android:textColorHint="#555555" android:maxLines="3"
                android:inputType="textMultiLine|textCapSentences" />

            <ImageButton
                android:id="@+id/btn_enviar_libre"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#121212"
                android:contentDescription="Enviar mensaje" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>