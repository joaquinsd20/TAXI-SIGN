<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".conductor.PanelConductorActivity" />

    <androidx.cardview.widget.CardView
        android:id="@+id/btnIrPerfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="#151B31"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnIrGanancias">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/bg_borde"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_amarillo_circular"
                android:text="👤"
                android:gravity="center"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvNombreConductor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hola, Conductor"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
                <TextView
                    android:id="@+id/btnIrComentarios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 4.9 (Ver reseñas)"
                    android:textColor="#FFD600"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/btnIrGanancias"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#FFD600"
        app:cardCornerRadius="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="💰"
            android:gravity="center"
            android:textSize="22sp"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnIrGanancias"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/btnIrDocumentos"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#151B31"
            app:cardCornerRadius="25dp">
            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="🪪" android:gravity="center" android:textSize="18sp"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnIrSoporte"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#151B31"
            app:cardCornerRadius="25dp">
            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="🎧" android:gravity="center" android:textSize="18sp"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnIrAjustes"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardBackgroundColor="#151B31"
            app:cardCornerRadius="25dp">
            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="⚙️" android:gravity="center" android:textSize="18sp"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCentrarUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@android:drawable/ic_menu_mylocation"
        app:backgroundTint="#FFD600"
        app:tint="#151B31"
        app:fabSize="normal"
        app:layout_constraintBottom_toTopOf="@id/cardStatsHoy"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Centrar en mi ubicación exacta" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardStatsHoy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#151B31"
        app:cardCornerRadius="20dp"
        app:layout_constraintBottom_toTopOf="@+id/btnToggleStatus">

        <LinearLayout
            android:background="@drawable/bg_borde"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:id="@+id/tvStatusLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ESTÁS DESCONECTADO"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textColor="#B8C1D9"
                android:textSize="12sp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ganancia Hoy" android:textColor="#B8C1D9" android:textSize="11sp"/>
                    <TextView android:id="@+id/tvGananciaHoy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S/ 0.00" android:textStyle="bold" android:textSize="18sp" android:textColor="#FFD600"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="30dp" android:background="#252D47" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Viajes Hoy" android:textColor="#B8C1D9" android:textSize="11sp"/>
                    <TextView android:id="@+id/tvViajesHoy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="18sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnToggleStatus"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_margin="16dp"
        android:text="INICIAR TURNO"
        android:backgroundTint="#FFD600"
        android:textColor="#151B31"
        android:textStyle="bold"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>